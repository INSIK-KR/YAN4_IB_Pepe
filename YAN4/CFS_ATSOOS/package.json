{
  "name": "cfs-atsoos",
  "version": "0.4.4",
  "private": true,
  "description": "CFS ATSOOS",
  "author": {
    "name": "YAN4 IB Pepe"
  },
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.66.0",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "com.cfs.atsoos",
    "productName": "CFS ATSOOS",
    "copyright": "YAN4 IB Pepe",
    "artifactName": "${productName} ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "powerbi-export.js",
      "powerbi-query.json",
      "wms-order.js",
      "dist/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
