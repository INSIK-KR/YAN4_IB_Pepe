{
  "name": "cfs-htp",
  "version": "0.4.1",
  "private": true,
  "description": "CFS HTP",
  "author": {
    "name": "YAN4 IB Pepe"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cfs.htp",
    "productName": "CFS HTP",
    "copyright": "YAN4 IB Pepe",
    "artifactName": "${productName} ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
